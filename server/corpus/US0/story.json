  "testFile": "test/greeting.test.ts",
  "testsAvailableFromStep": 2,
  "probes": [
    {
      "step": 1,
      "question": "What does formatGreeting({ name: \"Ada\" }) return when no formal flag is given?",
      "options": [
        "Hi Ada!",
        "Dear Ada,",
        "Hello Ada",
        "An error is thrown"
      ],
      "script": "probe1.ts",
      "expected": {
        "Correct": "Hi Ada!",
        "Flawed": "Hi Ada!"
      }
    },
    {
      "step": 2,
      "question": "What does formatGreeting({ name: \"  Ada \", formal: true }) return?",
      "options": [
        "Dear Ada,",
        "Dear   Ada ,",
        "Hi Ada!",
        "Dear Ada"
      ],
      "script": "probe2.ts",
      "expected": {
        "Correct": "Dear Ada,",
        "Flawed": "Dear Ada,"
      }
    },
    {
      "step": 3,
      "question": "What does greetAll([\"Ada\", \"Grace\"], true) return?",
      "options": [
        "Dear Ada,, Dear Grace,",
        "Hi Ada!, Hi Grace!",
        "Dear Ada, Grace,",
        "An error is thrown"
      ],
      "script": "probe3.ts",
      "expected": {
        "Correct": "Dear Ada,, Dear Grace,",
        "Flawed": "Dear Ada,, Dear Grace,"
      }
    }
  ],
  "understanding": {
